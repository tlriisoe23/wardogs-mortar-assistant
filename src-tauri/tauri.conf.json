{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WARDOGS Mortar Assistant HUD",
  "version": "2.1.0",
  "identifier": "net.tail0908d2.wardogs-mortar-assistant",
  "build": {
    "frontendDist": "../",
    "devUrl": "https://pve-ubuntu.tail0908d2.ts.net:8099"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WARDOGS Mortar & Artillery Assistant HUD (:8099)",
        "url": "https://pve-ubuntu.tail0908d2.ts.net:8099/?hud=1",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https://pve-ubuntu.tail0908d2.ts.net:8099 http://127.0.0.1:8099 'unsafe-inline' data: blob:; connect-src 'self' https://pve-ubuntu.tail0908d2.ts.net:8099 http://127.0.0.1:8099;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
